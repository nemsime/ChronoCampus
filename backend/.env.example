# Copy to backend/.env. Never commit real credentials.
# Use a dedicated account with SELECT access to CourseGroup and Major.
SQLSERVER_CONNECTION_STRING="DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost,1433;DATABASE=ChronoCampus;UID=chronocampus_reader;PWD=replace-me;Encrypt=yes;TrustServerCertificate=no"
# For a local server with a self-signed certificate only, use TrustServerCertificate=yes.
DB_TIMEOUT_SECONDS=5
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
