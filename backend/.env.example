# Copy to backend/.env. Never commit real credentials.
# Apply migrations with schema-owner credentials on an isolated development database.
# The running API needs SELECT/INSERT/UPDATE/DELETE on application tables.
SQLSERVER_CONNECTION_STRING="DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost,1433;DATABASE=ChronoCampus_Development;UID=chronocampus_app;PWD=replace-me;Encrypt=yes;TrustServerCertificate=no"
# For a local server with a self-signed certificate only, use TrustServerCertificate=yes.
DB_TIMEOUT_SECONDS=5
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
PUBLIC_URL=http://localhost:3000
# false is for local HTTP only; use true with HTTPS outside local development.
COOKIE_SECURE=false
SESSION_HOURS=12
RESET_MINUTES=30
# University domains must be configured explicitly. example.invalid is demo-only.
UNIVERSITY_EMAIL_DOMAINS=["example.invalid"]
# file writes local test emails to backend/.mail; smtp sends via STARTTLS.
MAIL_MODE=file
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Initialize with scripts/local.ps1 init-mail-key; never commit or print keys.
# MAIL_KEYS_FILE=C:/path/to/ChronoCampus/backend/.secrets/mail-keys.json

# Native local launcher sets roles/instance IDs and per-role pool limits.
JOB_LEASE_SECONDS=60
JOB_HEARTBEAT_SECONDS=10
JOB_POLL_SECONDS=1
JOB_MAX_ATTEMPTS=3
GENERATION_QUEUE_LIMIT=4
SOLVER_GRACE_SECONDS=180
SOLVER_MEMORY_MB=2048

# Diagnostics: safe JSON logs, bounded rotation. Paths are relative to backend cwd.
# DIAGNOSTIC_LOG_DIRECTORY=.logs
DIAGNOSTIC_LOG_MAX_BYTES=5000000
DIAGNOSTIC_LOG_BACKUPS=5
DIAGNOSTIC_DEBUG=false
# Optional dedicated metrics scraper only; never grants access to other admin routes.
METRICS_TOKEN=
# METRICS_TOKEN_FILE=C:/path/to/ChronoCampus/monitoring/secrets/metrics_token
